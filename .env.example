# OncoImmunoRAG — local environment template
# --------------------------------------------------------------------
# Copy this file to `.env` and fill in the real values:
#     cp .env.example .env
# `.env` is listed in .gitignore and will never be committed.
#
# NOTE: the codebase does NOT auto-load this file (there is no
#       python-dotenv dependency). Export the variables before starting
#       the app, e.g. from bash:
#           set -a; . ./.env; set +a
#
# Priority, as implemented in src/utils/config_loader.py and
# src/retrieval/query_engine.py:
#   OPENAI_API_KEY  env var  >  config.yaml        (env wins)
#   LLM_BASE_URL    config.yaml  >  env var  >  https://api.openai.com/v1
#   LLM_MODEL       config.yaml  >  env var  >  gpt-4o-mini
#
# ---------------------------------------------------------------------------
# LLM credential for the OpenAI-compatible endpoint.
# Leave empty to run in a no-LLM configuration; OpenAI-backed calls then
# raise a RuntimeError with an actionable message.
OPENAI_API_KEY=

# Optional overrides. Note these two are LOWER priority than the identically
# named keys in config.yaml — edit config.yaml instead if you need them to
# take effect.
LLM_BASE_URL=https://api.minimaxi.com/v1
LLM_MODEL=MiniMax-Text-01
