# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Poetry
# NOTE: poetry.lock is intentionally NOT ignored — the lock file must be
# versioned so that dependency resolution is reproducible across machines.

# Virtual envs
.venv/
venv/

# Stale snapshot of src/ — kept on disk for reference only, never committed.
# It is missing retrieval/pubmed_client.py and retrieval/temp_indexer.py, and its
# selector.py predates the evidence-grade rerank layer. Committing it would put
# an obsolete source tree in history and confuse code search / AI agents.
# See CURRENT_ISSUES.md ISSUE-038.
src_00/

# Project data (do not commit PDFs / vector DB)
data/raw/*
!data/raw/.gitkeep
data/vector_db/*
!data/vector_db/.gitkeep
data/vector_db_22/*
verification/*.pdf
holdout/*.pdf

# Local Claude Code settings (machine-specific permission allow-list)
.claude/settings.local.json

# NOTE: evaluation outputs (tests/results/, data/benchmark_results/,
# verification/results/, holdout/results/, holdout/rerank_ab/,
# holdout/search_ab/) and generated charts (result/) are deliberately NOT
# ignored here. They stay on disk and remain visible to `git status` until
# the pipeline is fixed and the benchmarks are re-run. Only the inputs
# (source PDFs, vector DBs) and the test/tooling code are ignored or
# tracked as appropriate.

# IDE
.vscode/
.idea/
*.swp

# Env
.env
